{
  "name": "@lse/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:preview": "tsc -p tsconfig.json && vite build --mode demo --outDir dist-preview",
    "preview:static": "vite preview --outDir dist-preview --port 4174 --host 127.0.0.1",
    "screenshots": "pnpm build:preview && playwright test -c playwright.screens.config.ts",
    "test:e2e:pwa": "vite build && playwright test -c playwright.pwa.config.ts"
  },
  "dependencies": {
    "@lse/shared": "workspace:*",
    "@tanstack/query-async-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1"
  }
}
