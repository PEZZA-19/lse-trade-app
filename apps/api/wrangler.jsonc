{
  // Cloudflare Workers config. Not deployed yet: no Cloudflare account is connected.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lse-trade-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "APP_ORIGIN": "http://127.0.0.1:5173" },
  // Release held emails every minute (the inbox also releases them when it is opened).
  "triggers": { "crons": ["* * * * *"] },
  // Photos: uncomment once an R2 bucket exists (London/EU jurisdiction). Until then uploads answer 503.
  // "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "lse-trade-photos" }],
  // Secrets, set with `wrangler secret put` (never in this file): TURNSTILE_SECRET.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Placeholder until a Neon (London) database and Hyperdrive config exist.
      "id": "00000000000000000000000000000000",
      // `wrangler dev` connects straight to the local Postgres from tools/devdb.mjs.
      "localConnectionString": "postgres://lse_app:lse_app@127.0.0.1:54329/lse_dev",
    },
  ],
}
