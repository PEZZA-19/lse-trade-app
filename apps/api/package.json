{
  "name": "@lse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "dev:worker": "wrangler dev",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/db/seed-cli.ts",
    "seed:reset": "tsx src/db/seed-cli.ts --reset",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "sign-in-link": "tsx src/dev/sign-in-link.ts"
  },
  "dependencies": {
    "@lse/shared": "workspace:*",
    "hono": "^4.13.18",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@hono/node-server": "^2.1.7",
    "@types/node": "^26.6.6",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7",
    "wrangler": "^4.160.0"
  }
}
